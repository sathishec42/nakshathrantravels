NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/nakshathrantravels

# Use independently generated random secrets of at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OAUTH_STATE_SECRET=

# Google Maps Directions, Distance Matrix, and Geocoding APIs must be enabled.
GOOGLE_MAPS_API_KEY=
ROUTE_STATE_SAMPLE_METERS=20000
# Configure official, current estimates only. Example shape: {"IN-KA":1000,"IN-TN":1000}
BORDER_TAX_ESTIMATES_INR={}

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/oauth/github/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_OAUTH_CALLBACK_URL=https://localhost:4000/api/auth/oauth/apple/callback
FIREBASE_SERVICE_ACCOUNT_JSON=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_API_BASE_URL=/api
REACT_APP_GOOGLE_MAPS_API_KEY=

# Seed script inputs; set only when running npm run seed:superadmin.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=
